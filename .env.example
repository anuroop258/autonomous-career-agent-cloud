# Reuse the same local Gemini configuration as the working desktop chatbot.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
ENABLE_GEMINI=1
# Optional: point directly to the chatbot's .env instead of copying the key.
# GEMINI_ENV_FILE=C:\path\to\gemini_chatbot\.env
OLLAMA_ENABLED=0
MODEL_RETRIES=1
MODEL_RETRY_BACKOFF=1.0
